{
  "manifest_version": 3,
  "name": "Swipe for Letterboxd",
  "version": "6.3.0",
  "version_name": "6.3.0-beta.2",
  "description": "Swipe-style interface and local profile database for filtering, searching, and reviewing your Letterboxd history",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://letterboxd.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/film/*",
        "https://letterboxd.com/films/*",
        "https://letterboxd.com/*/films/*",
        "https://letterboxd.com/*/watchlist/*",
        "https://letterboxd.com/*/list/*"
      ],
      "js": ["film-state.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Swipe for Letterboxd"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
